---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const href = (path) => `${base}${path.replace(/^\//, "")}`;

const frontmatter = {
  title: "Sadrazam",
  description: "Dependency and code-hygiene analysis with deterministic output, low false positives, and agent-friendly reports.",
  template: "splash" as const,
  pagefind: false,
};

const featureCards = [
  {
    title: "Dependency hygiene",
    text: "Find unused dependencies, missing packages, and misplaced devDependencies across package workspaces, tool configs, and CI.",
  },
  {
    title: "Reachability analysis",
    text: "Trace unused files, unused exports, duplicate aliases, and unresolved local imports through real source graphs.",
  },
  {
    title: "CI-aware usage",
    text: "Read GitHub Actions, GitLab CI, CircleCI, Azure Pipelines, and Bitbucket Pipelines commands so CI-only tools are counted as used.",
  },
  {
    title: "Agent output",
    text: "Use JSON, TOON, markdown, or SARIF when humans, CI jobs, and agents need stable contracts.",
  },
];

const pluginRows = [
  ["Frontend", "Astro, Next, SvelteKit, Vite, webpack, Rollup"],
  ["Testing", "Vitest, Jest, Playwright, Cypress, Storybook"],
  ["Quality", "ESLint, Prettier, Tailwind, TypeScript, Babel, PostCSS, Commitlint, lint-staged, Husky"],
  ["Monorepo", "pnpm workspace, Turbo, Nx, Lerna, Rush"],
  ["CI", "GitHub Actions, GitLab CI, CircleCI, Azure Pipelines, Bitbucket Pipelines"],
];
---

<StarlightPage frontmatter={frontmatter} hasSidebar={false}>
  <div class="landing-shell">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Declutter your JavaScript & TypeScript projects</p>
        <h1>Sadrazam</h1>
        <p class="lede">
          Dependency and code-hygiene analysis with deterministic output, low false positives, and agent-friendly reports.
        </p>
        <div class="actions">
          <a class="hero-button" href={href("getting-started/")}>Let's Get Started<span aria-hidden="true">→</span></a>
          <div class="secondary-actions">
            <a href="https://www.npmjs.com/package/sadrazam">View on npm</a>
            <a href="https://github.com/borakilicoglu/sadrazam">View on GitHub</a>
          </div>
        </div>
        <div class="badges" aria-label="Package badges">
          <span><img src="https://img.shields.io/npm/v/sadrazam?label=npm" alt="npm version" /></span>
          <span><img src="https://img.shields.io/npm/dt/sadrazam?label=downloads" alt="npm downloads" /></span>
          <span><img src="https://img.shields.io/npm/l/sadrazam?label=license" alt="MIT license" /></span>
        </div>
      </div>

      <section class="terminal" aria-label="Sadrazam example output">
        <div class="terminal-top">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <pre><code><span class="muted">$</span> npx sadrazam . --reporter toon

workspaces[1]:
  workspace:
    name=sadrazam
  summary:
    activePlugins=[github-actions, gitlab-ci, circleci, azure-pipelines, bitbucket-pipelines]
    findings=0

<span class="ok">No dependency issues found.</span></code></pre>
      </section>
    </section>

    <section class="section intro">
      <div>
        <p class="eyebrow">Why use it?</p>
        <h2>Clean package.json and source graphs without guessing.</h2>
      </div>
      <p>
        Sadrazam scans source files, scripts, package manifests, aliases, framework conventions, and CI workflows to report findings that are useful locally and strict enough for automation.
      </p>
    </section>

    <section class="cards" aria-label="Sadrazam capabilities">
      {featureCards.map((card) => (
        <article>
          <h3>{card.title}</h3>
          <p>{card.text}</p>
        </article>
      ))}
    </section>

    <section class="section plugin-section">
      <div>
        <p class="eyebrow">Built for real repos</p>
        <h2>Modern project support is part of the scanner.</h2>
      </div>
      <div class="plugin-table" role="table" aria-label="Supported scanner groups">
        {pluginRows.map(([group, tools]) => (
          <div class="plugin-row" role="row">
            <strong role="cell">{group}</strong>
            <span role="cell">{tools}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="section cta">
      <div>
        <h2>Start with one scan.</h2>
        <p>Run Sadrazam locally, then choose text, JSON, TOON, markdown, or SARIF output based on your workflow.</p>
      </div>
      <a class="sl-link-button primary" href={href("usage/")}>Read CLI Usage</a>
    </section>

    <footer class="landing-footer">
      <span>MIT License</span>
      <span>© 2026</span>
      <span>Sadrazam</span>
    </footer>
  </div>
</StarlightPage>

<style>
  :global(:root) {
    --sl-content-width: 72rem;
  }

  :global(main > .content-panel:first-of-type) {
    display: none;
  }

  :global(main > .content-panel:nth-of-type(2)) {
    padding-top: 0;
    border-top: 0;
  }

  :global(main > .content-panel:nth-of-type(2) > .sl-container > footer) {
    display: none;
  }

  .landing-shell {
    max-width: 72rem;
    margin-inline: auto;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(22rem, 0.78fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    min-height: min(42rem, calc(100vh - var(--sl-nav-height) - 3rem));
    padding: clamp(3rem, 7vw, 6rem) 0 clamp(2.5rem, 6vw, 5rem);
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(4.2rem, 10vw, 7.25rem);
    line-height: 0.9;
    letter-spacing: 0;
  }

  .lede {
    max-width: 43rem;
    color: var(--sl-color-gray-2);
    font-size: clamp(1.18rem, 2.2vw, 1.6rem);
    line-height: 1.55;
  }

  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.95rem;
    margin-top: 2rem;
  }

  .hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    min-height: 3.35rem;
    border: 2px solid #a8b1ff;
    border-radius: 999px;
    padding: 0.72rem 1.45rem;
    background: linear-gradient(135deg, #a8b1ff 0%, #8f99f5 100%);
    color: #0d1117;
    font-size: clamp(0.95rem, 1.25vw, 1.12rem);
    font-weight: 650;
    line-height: 1;
    text-decoration: none;
  }

  .hero-button span {
    font-size: 1.45em;
    line-height: 1;
    transition: transform 150ms ease;
  }

  .hero-button:hover,
  .hero-button:focus-visible {
    color: #0d1117;
    text-decoration: none;
  }

  .hero-button:hover span,
  .hero-button:focus-visible span {
    transform: translateX(0.18rem);
  }

  .secondary-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .secondary-actions a {
    color: var(--sl-color-gray-2);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .secondary-actions a:hover,
  .secondary-actions a:focus-visible {
    color: var(--sl-color-accent-high);
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.35rem;
  }

  .badges span {
    display: inline-flex;
    align-items: center;
    height: 22px;
    line-height: 0;
  }

  .badges img {
    display: block;
    height: 22px;
  }

  .terminal {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    background: var(--sl-color-black);
    box-shadow: var(--sl-shadow-lg);
    overflow: hidden;
  }

  .terminal-top {
    display: flex;
    gap: 0.5rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    background: color-mix(in srgb, var(--sl-color-gray-6), transparent 35%);
  }

  .terminal-top span {
    width: 0.72rem;
    height: 0.72rem;
    border-radius: 999px;
    background: var(--sl-color-accent);
  }

  .terminal-top span:nth-child(2) {
    background: var(--sl-color-accent-high);
  }

  .terminal-top span:nth-child(3) {
    background: var(--sl-color-gray-2);
  }

  pre {
    margin: 0;
    padding: clamp(1.2rem, 3vw, 2rem);
    overflow: auto;
    color: var(--sl-color-gray-2);
    font-size: clamp(0.82rem, 1.5vw, 0.98rem);
    line-height: 1.65;
  }

  code {
    font-family: var(--__sl-font-mono);
  }

  .muted {
    color: var(--sl-color-gray-3);
  }

  .ok,
  .eyebrow {
    color: var(--sl-color-accent-high);
  }

  .section,
  .cards {
    margin: 0 0 clamp(2.75rem, 7vw, 5rem);
  }

  .section {
    border-top: 1px solid var(--sl-color-gray-5);
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }

  .intro,
  .plugin-section,
  .cta {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
  }

  .eyebrow {
    margin: 0 0 0.9rem;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 42rem;
    margin: 0;
    font-size: clamp(2rem, 3.2vw, 3rem);
    line-height: 1.05;
    letter-spacing: 0;
  }

  h3,
  p {
    margin-top: 0;
  }

  .intro p,
  .cards p,
  .cta p,
  .plugin-row span {
    color: var(--sl-color-gray-2);
    font-size: 1.03rem;
    line-height: 1.65;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: stretch;
    gap: 1rem;
    margin-bottom: clamp(3.75rem, 8vw, 6rem);
  }

  .cards article {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 13rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    padding: 1.25rem;
    background: var(--sl-color-bg-nav);
  }

  .cards article,
  .cards article:first-child {
    margin: 0;
  }

  h3 {
    margin-bottom: 0.65rem;
    font-size: 1.05rem;
  }

  .plugin-table {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    overflow: hidden;
    background: var(--sl-color-bg-nav);
  }

  .plugin-row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    padding: 1rem;
  }

  .plugin-row + .plugin-row {
    border-top: 1px solid var(--sl-color-gray-5);
  }

  .plugin-row strong {
    color: var(--sl-color-white);
  }

  .cta {
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .cta p {
    max-width: 42rem;
    margin-bottom: 0;
  }

  .landing-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    border-top: 1px solid var(--sl-color-gray-5);
    padding: 1.25rem 0 0;
    color: var(--sl-color-gray-3);
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .hero,
    .intro,
    .plugin-section,
    .cta {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: auto;
      padding-top: 3rem;
    }

    .cards {
      grid-template-columns: 1fr;
    }

    .plugin-row {
      grid-template-columns: 1fr;
    }
  }
</style>
