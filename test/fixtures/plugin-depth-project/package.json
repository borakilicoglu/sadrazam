{
  "name": "plugin-depth-project",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite --config ./vite.config.ts",
    "test": "vitest --config ./vitest.config.ts",
    "unit": "jest --config ./jest.config.ts",
    "e2e": "playwright test ./tests/example.spec.ts",
    "cy": "cypress run",
    "storybook": "storybook dev",
    "build": "next build",
    "astro": "astro build",
    "svelte": "svelte-kit sync",
    "bundle": "webpack --config ./webpack.config.cjs",
    "rollup": "rollup -c ./rollup.config.mjs",
    "typecheck": "tsc -p ./tsconfig.json",
    "lint": "eslint --parser @typescript-eslint/parser --plugin react-hooks src/index.ts",
    "format": "prettier --plugin prettier-plugin-tailwindcss --config ./prettier.config.cjs src/index.ts",
    "css": "tailwindcss -c ./tailwind.config.cjs",
    "biome": "biome check src/index.ts",
    "stylelint": "stylelint --custom-syntax postcss-scss src/styles.css",
    "hooks": "lefthook run pre-commit"
  },
  "dependencies": {
    "@biomejs/biome": "^2.0.0",
    "@astrojs/mdx": "^4.0.0",
    "@next/bundle-analyzer": "^16.0.0",
    "@playwright/test": "^1.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@storybook/react-vite": "^10.0.0",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@tailwindcss/forms": "^1.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-istanbul": "^4.0.0",
    "astro": "^6.0.0",
    "cypress": "^15.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "html-webpack-plugin": "^5.0.0",
    "jest": "^30.0.0",
    "lefthook": "^1.0.0",
    "next": "^16.0.0",
    "postcss-scss": "^4.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^1.0.0",
    "rollup": "^4.0.0",
    "storybook": "^10.0.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-order": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0",
    "typescript-plugin-css-modules": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "webpack": "^5.0.0"
  }
}
