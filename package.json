{
  "name": "sadrazam",
  "version": "0.1.13",
  "description": "Dependency analysis CLI for JavaScript and TypeScript projects with optional AI-powered insights.",
  "main": "dist/index.js",
  "bin": {
    "sadrazam": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts .",
    "scan": "tsx src/index.ts .",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "test": "npm run build && vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "docs:dev": "cd docs && ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "docs:build": "cd docs && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "docs:preview": "cd docs && ASTRO_TELEMETRY_DISABLED=1 astro preview"
  },
  "keywords": [
    "dependency-analysis",
    "dependency-hygiene",
    "unused-dependencies",
    "dependency-checker",
    "package-json",
    "unused-files",
    "unused-exports",
    "unresolved-imports",
    "static-analysis",
    "code-hygiene",
    "monorepo",
    "javascript",
    "typescript",
    "cli",
    "sarif",
    "toon",
    "oxc",
    "ai"
  ],
  "author": "Bora Kilicoglu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borakilicoglu/sadrazam.git"
  },
  "homepage": "https://github.com/borakilicoglu/sadrazam#readme",
  "bugs": {
    "url": "https://github.com/borakilicoglu/sadrazam/issues"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3",
    "oxc-parser": "^0.132.0",
    "oxc-resolver": "^11.19.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.39.2",
    "@types/node": "^25.5.0",
    "astro": "^6.3.7",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
